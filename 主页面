-- 创建卡密验证UI
local function showPasswordUI()
    local WindUI = loadstring(game:HttpGet("https://raw.githubusercontent.com/Footagesus/WindUI/main/dist/main.lua"))()
    
    -- 创建卡密验证窗口
    local PasswordWindow = WindUI:CreateWindow({
        Title = "卡密验证",
        Folder = "炸学校脚本",
        Size = UDim2.fromOffset(300, 180),
        -- 设置窗口不可拖动，确保用户必须完成验证
        Draggable = false,
    })
    
    -- 修改打开按钮文本
    PasswordWindow:EditOpenButton({
        Title = "［炸学校脚本］",
        Color = ColorSequence.new(Color3.fromRGB(255, 0, 0), Color3.fromRGB(128, 0, 0)),
        Draggable = false,
    })
    
    -- 创建选项卡
    local AuthTab = PasswordWindow:Tab({
        Title = "验证",
        Icon = "lock",
    })
    
    -- 添加说明
    AuthTab:Label({
        Title = "请输入卡密以继续使用",
    })
    
    -- 创建输入框
    local passwordInput = ""
    local inputBox
    
    AuthTab:Input({
        Title = "卡密",
        Placeholder = "请输入卡密",
        Callback = function(value)
            passwordInput = value
        end,
    })
    
    -- 确认按钮
