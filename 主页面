    -- ====== 创建动态边框 ======
    local borderConnection = nil

    local function createDynamicBorder(frame, style, speed)
        if not frame then return nil end
        
        if borderConnection then
            borderConnection:Disconnect()
        end
        
        local currentColorIndex = 1
        local lastChangeTime = tick()
        local colorChangeInterval = 1 / speed
        
        local function updateBorder()
            if not frame or not frame.Parent then
                if borderConnection then
                    borderConnection:Disconnect()
                    borderConnection = nil
                end
                return
            end
            
            local styleData = borderStyles[style]
            if not styleData then return end
            
            local newColor
            
            if styleData.type == "sequential" then
                local currentTime = tick()
                if currentTime - lastChangeTime >= colorChangeInterval then
                    currentColorIndex = currentColorIndex + 1
                    if currentColorIndex > #styleData.colors then
                        currentColorIndex = 1
                    end
                    lastChangeTime = currentTime
                end
                newColor = Color3.fromHex(styleData.colors[currentColorIndex])
                
            elseif styleData.type == "rainbow" then
                local hue = (tick() * 0.1 * speed) % 1
                newColor = Color3.fromHSV(hue, 1, 1)
                
            elseif styleData.type == "gradient" then
                local colorIndex = (tick() * 0.2 * speed) % #styleData.colors
                local nextIndex = (math.floor(colorIndex) % #styleData.colors) + 1
                
                local color1 = Color3.fromHex(styleData.colors[math.floor(colorIndex) + 1])
                local color2 = Color3.fromHex(styleData.colors[nextIndex])
                
                local progress = colorIndex - math.floor(colorIndex)
                local r = color1.R + (color2.R - color1.R) * progress
                local g = color1.G + (color2.G - color1.G) * progress
                local b = color1.B + (color2.B - color1.B) * progress
                
                newColor = Color3.new(r, g, b)
                
            elseif styleData.type == "random" then
                local randomIndex = math.random(1, #styleData.colors)
                newColor = Color3.fromHex(styleData.colors[randomIndex])
            end
            
            if newColor then
                local stroke = frame:FindFirstChildOfClass("UIStroke")
                if stroke then
                    stroke.Color = newColor
                end
                
                local openButton = WindUI and WindUI:GetOpenButton()
                if openButton then
                    local btnStroke = openButton:FindFirstChildOfClass("UIStroke")
                    if btnStroke then
                        btnStroke.Color = newColor
                    end
                end
            end
        end
        
        borderConnection = game:GetService("RunService").Heartbeat:Connect(updateBorder)
        return borderConnection
    end

