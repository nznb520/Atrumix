    titleLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
    titleLabel.TextSize = 14
    titleLabel.Font = Enum.Font.GothamSemibold
    titleLabel.Parent = mainFrame
    
    local timeLabel = Instance.new("TextLabel")
    timeLabel.Name = "TimeLabel"
    timeLabel.Size = UDim2.new(1, 0, 0, 30)
    timeLabel.Position = UDim2.new(0, 0, 0, 25)
    timeLabel.BackgroundTransparency = 1
    timeLabel.Text = "00:00:00"
    timeLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
    timeLabel.TextSize = 20
    timeLabel.Font = Enum.Font.GothamBold
    timeLabel.Parent = mainFrame
    
    local function updateGradient()
        local hue = tick() % 10 / 10
        local r, g, b
        if hue < 1/6 then
            r = 1; g = hue * 6; b = 0
        elseif hue < 2/6 then
            r = (2/6 - hue) * 6; g = 1; b = 0
        elseif hue < 3/6 then
            r = 0; g = 1; b = (hue - 2/6) * 6
        elseif hue < 4/6 then
            r = 0; g = (4/6 - hue) * 6; b = 1
        elseif hue < 5/6 then
            r = (hue - 4/6) * 6; g = 0; b = 1
        else
            r = 1; g = 0; b = (1 - hue) * 6
        end
        timeLabel.TextColor3 = Color3.new(r, g, b)
    end
    
    local function updateTime()
        local utcTime = os.time()
        local beijingTime = utcTime + 8 * 3600
        local timeTable = os.date("!*t", beijingTime)
        local timeString = string.format("%02d:%02d:%02d", timeTable.hour, timeTable.min, timeTable.sec)
        timeLabel.Text = timeString
        updateGradient()
    end
    
    local timeConnection
    timeConnection = game:GetService("RunService").Heartbeat:Connect(function()
        updateTime()
    end)
    updateTime()
    
    return screenGui, timeConnection
end

