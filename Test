local function autoDetectAndExecute()
    local currentGameId = game.PlaceId
    local gameInfo = GameScripts[currentGameId]
    
    if gameInfo then
        if Loaded_Main_Lua and Loaded_Main_Lua.Notify then
            Loaded_Main_Lua:Notify({
                Title = "检测到支持的游戏",
                Content = string.format("游戏名称: %s\n游戏ID: %d", gameInfo[1], currentGameId),
                Duration = 5,
                Icon = "check-circle",
                Color = Color3.fromRGB(34, 197, 94)
            })
        end
        wait(1)
        if Loaded_Main_Lua and Loaded_Main_Lua.Notify then
            Loaded_Main_Lua:Notify({
                Title = "正在加载脚本",
                Content = string.format("正在为【%s】加载脚本...", gameInfo[1]),
                Duration = 3,
                Icon = "download",
                Color = Color3.fromRGB(59, 130, 246)
            })
        end
        
        local success, errorMsg = pcall(function()
            local scriptContent = game:HttpGet(gameInfo[2])
            if scriptContent and #scriptContent > 0 then
                local loadSuccess, loadError = loadstring(scriptContent)
                if loadSuccess then
                    loadSuccess()
                else
                    error("脚本编译失败: " .. tostring(loadError))
                end
            else
                error("获取的脚本内容为空")
            end
        end)
        
        if success then
            if Loaded_Main_Lua and Loaded_Main_Lua.Notify then
                Loaded_Main_Lua:Notify({
                    Title = "脚本加载成功",
                    Content = string.format("【%s】脚本已成功加载！", gameInfo[1]),
                    Duration = 4,
                    Icon = "check",
                    Color = Color3.fromRGB(34, 197, 94)
                })
            end
        else
            if Loaded_Main_Lua and Loaded_Main_Lua.Notify then
                Loaded_Main_Lua:Notify({
                    Title = "脚本加载失败",
                    Content = string.format("加载失败: %s", tostring(errorMsg)),
                    Duration = 5,
                    Icon = "x-circle",
                    Color = Color3.fromRGB(239, 68, 68)
                })
            end
        end
    else
        if Loaded_Main_Lua and Loaded_Main_Lua.Notify then
            Loaded_Main_Lua:Notify({
                Title = "未检测到支持的游戏",
                Content = string.format("当前游戏ID: %d\n此游戏暂无自动脚本", currentGameId),
                Duration = 6,
                Icon = "alert-circle",
                Color = Color3.fromRGB(245, 158, 11)
            })
        end
    end
end

