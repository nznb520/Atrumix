local selectedTargetPlayer = ""

local function teleportToPlayer(playerName)
    local target = game.Players:FindFirstChild(playerName)
    if target and target.Character and target.Character:FindFirstChild("HumanoidRootPart") then
        local localPlayer = game.Players.LocalPlayer
        if localPlayer.Character and localPlayer.Character:FindFirstChild("HumanoidRootPart") then
            localPlayer.Character.HumanoidRootPart.CFrame = target.Character.HumanoidRootPart.CFrame
            return true, "已传送到玩家: " .. playerName
        end
    end
    return false, "未找到玩家或玩家没有角色: " .. playerName
end

local function launchPlayer(playerName)
    local target = game.Players:FindFirstChild(playerName)
    if target and target.Character and target.Character:FindFirstChild("HumanoidRootPart") then
        local velocity = Instance.new("BodyVelocity")
        velocity.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
        velocity.Velocity = Vector3.new(0, 100, 0)
        velocity.Parent = target.Character.HumanoidRootPart
        
        wait(0.5)
        velocity:Destroy()
        return true, "已将玩家甩飞: " .. playerName
    end
    return false, "未找到玩家或玩家没有角色: " .. playerName
end

local function sitOnPlayerHead(playerName)
    local target = game.Players:FindFirstChild(playerName)
    if target and target.Character and target.Character:FindFirstChild("Head") then
        local localPlayer = game.Players.LocalPlayer
        if localPlayer.Character and localPlayer.Character:FindFirstChild("HumanoidRootPart") then
            local headPosition = target.Character.Head.Position
            local sitPosition = headPosition + Vector3.new(0, 2, 0)
            localPlayer.Character.HumanoidRootPart.CFrame = CFrame.new(sitPosition)
            
            wait(0.1)
            localPlayer.Character.Humanoid.Sit = true
            return true, "已坐到玩家头上: " .. playerName
        end
    end
    return false, "未找到玩家或玩家没有角色: " .. playerName
end

-- 2. 动态边框功能
local borderConnection = nil

local function createDynamicBorder(frame, style, speed)
    if not frame then return nil end
    
    if borderConnection then
        borderConnection:Disconnect()
    end
    
    local hue = 0
    local colorIndex = 1
    
    local function updateBorder()
        if not frame or not frame.Parent then
            if borderConnection then
                borderConnection:Disconnect()
                borderConnection = nil
            end
            return
        end
        
        local styleData = borderStyles[style] or borderStyles["🌈 彩虹渐变边框"]
        if not styleData then return end
        
        local newColor
        
        if styleData.type == "rainbow" then
            hue = (hue + (0.01 * speed)) % 1
            newColor = Color3.fromHSV(hue, 1, 1)
            
        elseif styleData.type == "gradient" then
            colorIndex = colorIndex + (0.05 * speed)
            if colorIndex > #styleData.colors then
                colorIndex = 1
            end
            
            local nextIndex = colorIndex + 1
            if nextIndex > #styleData.colors then
                nextIndex = 1
            end
            
            local color1 = Color3.fromHex(styleData.colors[math.floor(colorIndex)])
            local color2 = Color3.fromHex(styleData.colors[math.floor(nextIndex)])
            
            local progress = colorIndex - math.floor(colorIndex)
            local r = color1.R + (color2.R - color1.R) * progress
            local g = color1.G + (color2.G - color1.G) * progress
            local b = color1.B + (color2.B - color1.B) * progress
            
            newColor = Color3.new(r, g, b)
        end
        
        if newColor then
            local stroke = frame:FindFirstChildOfClass("UIStroke")
            if stroke then
                stroke.Color = newColor
            end
            
            local openButton = Loaded_Main_Lua and Loaded_Main_Lua:GetOpenButton()
            if openButton then
                local btnStroke = openButton:FindFirstChildOfClass("UIStroke")
                if btnStroke then
                    btnStroke.Color = newColor
                end
            end
        end
    end
    
    borderConnection = game:GetService("RunService").Heartbeat:Connect(updateBorder)
    return borderConnection
end

