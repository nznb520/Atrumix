-- 加载历史消息
function ChatSystem:LoadMessages()
    local savedMessages = loadSettings("chat_history_" .. currentUsername)
    if savedMessages and savedMessages.messages then
        self.messages = savedMessages.messages
        for _, msg in ipairs(self.messages) do
            self:AddMessageToDisplay(msg)
        end
    end
end

-- 保存消息历史
function ChatSystem:SaveMessages()
    saveSettings("chat_history_" .. currentUsername, {
        messages = self.messages
    })
end

-- 添加消息到显示
function ChatSystem:AddMessageToDisplay(message)
    if not self.messageBox then return end
    
    local msgLabel = Instance.new("TextLabel")
    msgLabel.Size = UDim2.new(1, -10, 0, 25)
    msgLabel.Position = UDim2.new(0, 5, 0, 0)
    msgLabel.BackgroundTransparency = 1
    msgLabel.Text = message
    msgLabel.TextColor3 = Color3.fromRGB(220, 220, 255)
    msgLabel.TextSize = 13
    msgLabel.Font = Enum.Font.Gotham
    msgLabel.TextXAlignment = Enum.TextXAlignment.Left
    msgLabel.Parent = self.messageBox
    
    -- 自动滚动到底部
    task.wait()
    self.messageBox.CanvasPosition = Vector2.new(0, self.messageBox.AbsoluteCanvasSize.Y)
end

-- 切换聊天窗口
function ChatSystem:ToggleChat()
    if not self.chatWindow then return end
    
    self.enabled = not self.enabled
    self.chatWindow.Visible = self.enabled
    self.toggleButton.Text = self.enabled and "💬 关闭聊天" or "💬 打开聊天"
end

-- 发送消息
function ChatSystem:SendMessage(text)
    if not text or text == "" then return end
    
    local timestamp = os.date("%H:%M:%S")
    local message = string.format("[%s] %s: %s", timestamp, currentUsername, text)
    
    -- 添加到本地消息
    table.insert(self.messages, message)
    if #self.messages > self.maxMessages then
        table.remove(self.messages, 1)
    end
    
    -- 更新显示
    self:AddMessageToDisplay(message)
    
    -- 保存历史
    self:SaveMessages()
    
    -- 广播消息
    self:BroadcastMessage(message)
end

-- 接收消息
function ChatSystem:ReceiveMessage(message)
    table.insert(self.messages, message)
    if #self.messages > self.maxMessages then
        table.remove(self.messages, 1)
    end
    
    self:AddMessageToDisplay(message)
    self:SaveMessages()
end

-- 广播消息
function ChatSystem:BroadcastMessage(message)
    -- 使用BindableEvent在脚本实例间通信
    if not self.bindableEvent then
        self.bindableEvent = Instance.new("BindableEvent")
        self.bindableEvent.Name = "ChatBroadcast"
        self.bindableEvent.Parent = game:GetService("CoreGui")
    end
    
    self.bindableEvent:Fire(message)
end

-- 开始接收消息
function ChatSystem:StartReceiving()
    if self.updateConnection then
        self.updateConnection:Disconnect()
    end
    
    -- 创建接收事件
    if not self.receiveEvent then
        self.receiveEvent = Instance.new("BindableEvent")
        self.receiveEvent.Name = "ChatReceive"
        self.receiveEvent.Parent = game:GetService("CoreGui")
    end
    
    -- 监听广播
    local broadcastEvent = game:GetService("CoreGui"):FindFirstChild("ChatBroadcast")
    if broadcastEvent then
        self.updateConnection = broadcastEvent.Event:Connect(function(message)
            -- 避免接收自己发送的消息
            if not message:find(currentUsername .. ":") then
                self:ReceiveMessage(message)
            end
        end)
    end
    
    -- 每秒检查一次新消息
    spawn(function()
        while self.chatWindow and self.chatWindow.Parent do
            task.wait(1)
            -- 可以在这里添加从服务器获取消息的逻辑
        end
    end)
end

-- 销毁聊天系统
function ChatSystem:Destroy()
    if self.updateConnection then
        self.updateConnection:Disconnect()
    end
    if self.screenGui then
        self.screenGui:Destroy()
    end
    self.chatWindow = nil
    self.messageBox = nil
    self.inputBox = nil
    self.toggleButton = nil
    self.screenGui = nil
end

-- ====== 检测使用本脚本的玩家 ======
local function detectScriptUsers()
    local users = {}
    
    -- 通过BindableEvent检测
    local coreGui = game:GetService("CoreGui")
    local chatBroadcast = coreGui:FindFirstChild("ChatBroadcast")
    local chatReceive = coreGui:FindFirstChild("ChatReceive")
    
    if chatBroadcast or chatReceive then
        -- 如果存在这些事件，说明有脚本在运行
        for _, player in ipairs(game.Players:GetPlayers()) do
            table.insert(users, player.Name)
        end
    end
    
